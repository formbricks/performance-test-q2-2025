# Target only an isolated Artemis performance-test workspace.
export FORMBRICKS_URL="https://artemis.example.com"
export FORMBRICKS_WORKSPACE_ID="<workspace-cuid>"
export FORMBRICKS_API_KEY="<read-write-api-key>"

# Kubernetes evidence collection (optional but recommended).
export NAMESPACE="formbricks-artemis"
export POD_SELECTOR="app.kubernetes.io/instance=formbricks-artemis"

# Load controls. Defaults are deliberately modest.
export RATE="5"
export DURATION="5m"
export MAX_VUS="100"
export P95_MS="2000"
export P99_MS="5000"

# Use a unique value when coordinating several terminals or repeating a run.
# export RUN_ID="eng3309-$(date -u +%Y%m%dT%H%M%SZ)"
