# Target only an isolated Artemis performance-test workspace.
export FORMBRICKS_URL="https://artemis.app.formbricks.com"
export FORMBRICKS_WORKSPACE_ID="<workspace-cuid>"
export FORMBRICKS_API_KEY="<read-write-api-key>"

# Kubernetes evidence collection (optional but recommended).
export NAMESPACE="formbricks-artemis"
export POD_SELECTOR="app.kubernetes.io/instance=formbricks-artemis,app.kubernetes.io/component=formbricks"
export KUBECTL_CONTEXT="core-eks"
export KUBECTL_REQUEST_TIMEOUT="10s"

# Optional load controls. Leave unset to use the deliberately modest per-profile defaults.
# export RATE="1"
# export DURATION="2m"
# export MAX_VUS="20"
export P50_MS="1000"
export P90_MS="1500"
export P95_MS="2000"
export P99_MS="5000"

# Health/capacity abort controls.
export MAX_HEALTH_SECONDS="5"
export MAX_HPA_MEMORY_UTILIZATION="85"

# Use a unique value when coordinating several terminals or repeating a run.
# export RUN_ID="eng3309-$(date -u +%Y%m%dT%H%M%SZ)"

# Never set this without explicit approval for stress, spike, or soak on shared Artemis.
# export CONFIRM_HIGH_IMPACT_PROFILE="I_APPROVE_SHARED_ARTEMIS_LOAD"

# Never set this without explicit approval to run beyond smoke while HPA has no scaling headroom.
# export CONFIRM_LIMITED_HPA_CAPACITY="I_ACCEPT_NO_AUTOSCALING_HEADROOM"
